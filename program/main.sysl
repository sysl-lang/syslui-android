// syslUI on Android: a form, a keyboard, and a phone's own scale.
//
// **One export and a screen, and that is the whole program.** The window, the frame loop, the event
// pump, the density, the texture upload and the system font are `sh.sysl.ui_sdl`'s -- the same
// driver the desktop demo runs, because the measurement said seventeen lines of a hundred and twenty
// were genuinely about being on a phone. The system bars, the orientation pair and the Java-side
// activity are `sh.sysl.skitter`'s. What is left here is the interface.
//
// **`SDL_main` rather than `main`.** Android has no `main`: `SDLActivity` loads `libmain.so` and
// looks up the symbol `SDL_main` in it, so what an Android program needs is an entry point the Java
// half can find rather than one that runs first. `@export` publishes exactly that, which is why
// there is no C in this repository at all.
//
// **It used to be two exports, and the second one is the whole reason Skitter exists.** The JNI
// method that reports the system bars had its symbol mangled from *this* application's package name,
// so it could not live in a library and was written out by hand here — kept in step with a Scala
// class that had to be renamed to match. Skitter fixes the activity at
// `sh.sysl.skitter.SkitterActivity`, which fixes the symbol, which lets the bridge be a library's.
// This program neither receives the bars nor reads them: syslui-sdl 0.2.0 pulls them from Skitter
// itself, at the one point in the frame they are used.

import sh.sysl.ui.*
import sh.sysl.ui_sdl.{app, run}
import sysl.seq.{Sequence, generate}

// What the window is asked for. On Android this decides only which way up the activity starts: SDL
// reads the requested shape, and wider-than-tall turns a phone sideways.
const WANTED_W: int = 400
const WANTED_H: int = 800

// How many rows the list holds -- enough to need the scrollbar.
const ROWS: int = 120

// Which field is which, to the keyboard. **They must differ and neither may be `NOBODY`**: two
// fields sharing an id would take each other's keys, and the failure looks like typing into the
// wrong box rather than like a missing argument.
const NAME_FIELD: int = 1
const NOTES_FIELD: int = 2

// ## The application
//
// **Every long-lived value the interface reads is a signal this program owns.** A control keeps
// nothing of its own, so the text somebody types survives the tree being thrown away sixty times a
// second because it was never inside it.
struct Model
    count: &Signal[int]
    volume: &Signal[int]
    offset: &Signal[int]
    daylight: &Signal[bool]
    agreed: &Signal[bool]
    tab: &Signal[int]
    name: &Signal[string]
    notes: &Signal[string]
    size: &Signal[int]
end Model

model() -> &Model =
    Model(signal(0), signal(40), signal(0), signal(false), signal(false), signal(0),
          signal(""), signal(""), signal(1))

private bump(s: &Signal[int], by: int) -> &Fn() -> unit = () -> s.set(s.read() + by)

private size_name(i: int) -> string =
    i match
        0 -> "small"
        1 -> "medium"
        _ -> "large"

// The rows, built once and kept, so a rebuild is priced on the tree rather than on formatting.
rows_of(n: int) -> [][]string =
    generate(usize(n), i -> [s"${i}", s"row number ${i}", if i % 2 == 0 then "ready" else "waiting"])

// The whole screen, rebuilt from scratch whenever anything is written.
//
// **Nothing here knows it is on a phone**, and the point of this repository is that the claim is
// true rather than aspirational: it is the same shape of tree the desktop demo builds, and the three
// things that differ -- the scale, the insets and the on-screen keyboard -- are the driver's.
screen(m: &Model, rows: [][]string) -> &View
    val look = if m.daylight.read() then light() else dark()

    val form = column(spacing = 10):
        text("name")
        text_field(m.name, NAME_FIELD, 320, "tap here and type")

        text("size")
        radio_group(["small", "medium", "large"], m.size)

        text("notes")
        text_area(m.notes, NOTES_FIELD, 320, 3, "several lines, if you like")

        divider()

        text(s"hello, ${if m.name.read() == "" then "stranger" else m.name.read()}")
        text(s"a ${size_name(m.size.read())} one, ${m.notes.read().len} bytes of notes")

    val controls = column(spacing = 12):
        row([
            text(s"count: ${m.count.read()}").padding(6).frame(110, 30),
            button("+", bump(m.count, 1)),
            button("−", bump(m.count, -1), .Error)
        ], 10)

        row([
            text("daylight").padding(2),
            switch(m.daylight, .Accent),
            spacer()
        ], 10)

        checkbox(m.agreed, "I agree to nothing")

        column(spacing = 4):
            text(s"volume ${m.volume.read()}%")
            slider(m.volume, 0, 100, 300)
            progress(real(m.volume.read()) / 100.0, 300, .Success)

    val data = table([col("#", true), flex_col("what"), col("state")], rows, m.offset, 260, None)

    val body = column(spacing = 10):
        text("syslUI on Android").padding(4)

        tabs(["Form", "Controls", "Data"], m.tab,
             i -> if i == 0 then form elif i == 1 then controls else data)

    body.padding(10).restyle(_ -> look)
end screen

// What the window is cleared to, which is the application's colour rather than the toolkit's — and
// that is now the whole of what it does.
//
// **It briefly had a second job and syslui-sdl 0.2.0 took it away.** Skitter's bars are *pulled*
// rather than pushed, so somebody has to read them, and the driver rebuilds its tree only when a
// signal is written — which turning a phone does not do. That left the ground colour, asked for once
// a frame unconditionally, as the only place a rotation could be noticed from here. The driver reads
// them itself now, at the one point they are used, and an application forwards nothing.
window_ground(m: &Model) -> u32 = if m.daylight.read() then 0xF7F8FA else 0x12141C

@export("SDL_main")
sdl_main(argc: i32, argv: **u8) -> i32
    val m = model()
    val rows = rows_of(ROWS)

    run(app("syslUI", () -> screen(m, rows), () -> window_ground(m), WANTED_W, WANTED_H))

    0
end sdl_main
